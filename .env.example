# DateNow — environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Agora — public App ID only. The App Certificate is a server secret and
# must be stored via `supabase secrets set AGORA_APP_CERTIFICATE=...`.
AGORA_APP_ID=

# App
APP_ENV=development

# Apple Sign In — see docs/AUTH_EXTERNAL_CONFIG.md sections 1 + 4.
# Set to `true` ONLY after completing the manual setup:
#   * Apple Dev Console: capability + Services ID + .p8 key
#   * Supabase Dashboard → Auth → Providers → Apple enabled
# Leave `false` (or empty) to hide the "Continue with Apple" button
# from the landing + the "Lier Apple" tile from Security, so no
# non-functional OAuth button reaches App Store Review.
APPLE_SIGN_IN_ENABLED=false

# Google Sign In — see docs/AUTH_EXTERNAL_CONFIG.md.
# REVERSED_CLIENT_ID of the iOS OAuth client created in Google Cloud
# Console for com.datenow.app. Example shape:
#   com.googleusercontent.apps.123456789012-abcdefghijklmnop
# Leave empty to feature-flag the Google Sign In button OFF (Apple
# rejects App Store archives that contain an unresolvable URL scheme;
# we surface the button only once this value AND the matching scheme
# in ios/Runner/Info.plist are both in place).
GOOGLE_REVERSED_CLIENT_ID_IOS=

# Web OAuth client ID — the value Supabase Auth → Providers → Google
# is configured with (NOT the iOS client). When this is set, the
# google_sign_in SDK is initialised with `serverClientId`, which tells
# Google to issue an ID token whose `aud` claim equals this Web Client
# ID. Without it, the token's `aud` is the iOS client and Supabase
# rejects the exchange with "Unacceptable audience in id_token".
# Found in: Google Cloud Console → Credentials → OAuth 2.0 Client IDs
# → the Web application client (forward form, ends in
# `.apps.googleusercontent.com`).
GOOGLE_WEB_CLIENT_ID=
