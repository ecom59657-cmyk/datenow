# DateNow — environment template.
# Copy this file to `.env` and fill in real values. `.env` is gitignored.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Agora — public App ID only. The App Certificate is a server secret and
# must be stored via `supabase secrets set AGORA_APP_CERTIFICATE=...`.
AGORA_APP_ID=

# App
APP_ENV=development

# Google Sign In — see docs/AUTH_EXTERNAL_CONFIG.md.
# REVERSED_CLIENT_ID of the iOS OAuth client created in Google Cloud
# Console for com.datenow.app. Example shape:
#   com.googleusercontent.apps.123456789012-abcdefghijklmnop
# Leave empty to feature-flag the Google Sign In button OFF (Apple
# rejects App Store archives that contain an unresolvable URL scheme;
# we surface the button only once this value AND the matching scheme
# in ios/Runner/Info.plist are both in place).
GOOGLE_REVERSED_CLIENT_ID_IOS=
