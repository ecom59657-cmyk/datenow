# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# DateNow — secrets & generated code
.env
.env.local
.env.*.local
*.g.dart
*.freezed.dart
lib/l10n/app_localizations*.dart

# DateNow — Android release signing (NEVER commit these)
android/key.properties
**/key.properties
*.jks
*.keystore

# DateNow — iOS signing / provisioning (NEVER commit these)
*.mobileprovision
*.p12
*.cer
*.certSigningRequest

# DateNow — Firebase iOS config (download from Firebase Console).
# Not a hard secret (the iOS app key is restricted server-side) but kept
# out of the repo so a stale / wrong-project plist doesn't ship.
**/GoogleService-Info.plist

# Tooling
.claude/

# Flutter verbose build log dumps (regenerated on demand, no historical value)
build_log.txt
build_log*.txt

# Supabase CLI local state
supabase/.temp/
