# Required by jitsi_meet_flutter_sdk (15.1+).
platform :ios, '15.1'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Didit SDK setup (Phase 6).
#
# DiditSDK is NOT published on the public CocoaPods trunk. The
# podspec is hosted on GitHub, and the official didit_sdk Flutter
# plugin documentation explicitly requires us to declare the pod
# with the :podspec URL inside the target block (see below). Without
# this declaration, pod install fails with :
#
#   [!] Unable to find a specification for `DiditSDK/All (~> 4.0)`
#                                                depended upon by `didit_sdk`
#
# We pick the Core subspec (no NFC) :
#   - supports iOS 13.0+ (our Podfile is 15.1 already, no impact),
#   - skips the Apple NFC review-video ceremony at submission,
#   - skips the com.apple.developer.nfc.* entitlements,
#   - skips the Near Field Communication capability in Xcode,
#   - smaller binary, faster build.
#
# Both env vars are set explicitly so the didit_sdk plugin's own
# podspec (which reads them when resolving its DiditSDK/<variant>
# transitive dependency) agrees with the variant we pre-declare
# below — avoiding any /All vs /Core conflict at install time.
ENV['DIDIT_SDK_IOS_NFC_ENABLED'] = 'false'
ENV['DIDIT_SDK_IOS_VARIANT']     = 'core'
didit_sdk_ios_pod      = 'DiditSDK/Core'
didit_sdk_ios_podspec  = 'https://raw.githubusercontent.com/didit-protocol/sdk-ios/main/DiditSDK.podspec'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  # Pre-declare DiditSDK with its GitHub-hosted podspec URL so the
  # transitive dependency requested by the didit_sdk Flutter plugin
  # resolves. See the documentation block above the variant selector
  # at the top of this Podfile for the why.
  pod didit_sdk_ios_pod, :podspec => didit_sdk_ios_podspec

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Apple removed bitcode support in Xcode 14+. Force OFF for every
      # pod target so the archive itself contains no bitcode references.
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      # dSYMs for non-Debug builds → fewer "Upload Symbols Failed"
      # warnings at App Store ingestion. We set this for both Release
      # AND Profile (when the Pods project ends up with a Profile
      # config), and we ALSO set GCC_GENERATE_DEBUGGING_SYMBOLS
      # explicitly — YES is the Xcode default, but being loud about
      # it beats losing symbolication silently after a CocoaPods
      # upgrade.
      #
      # Note: Agora's iOS xcframeworks (AgoraRtcKit, AgoraRtmKit,
      # Iris RTC and the audio/video extension dylibs) ship WITHOUT
      # dSYMs in the CocoaPods feed. App Store Connect will still log
      # "The archive did not include a dSYM for <…>.framework" for
      # each of them — not fixable from our side without Agora
      # publishing the symbols. See docs/IOS_DSYM_NOTES.md.
      if config.name == 'Release' || config.name == 'Profile'
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf-with-dsym'
        config.build_settings['GCC_GENERATE_DEBUGGING_SYMBOLS'] = 'YES'
      end
      # permission_handler_apple 9.x compiles each permission behind a
      # PERMISSION_* preprocessor flag. WITHOUT these, `Permission.camera`
      # / `Permission.microphone` request() returns `denied` synchronously
      # without ever calling AVCaptureDevice / AVAudioSession — iOS then
      # never asks the user and never shows the toggles in Settings.
      # Enable the ones DateNow actually uses: camera, microphone, photos.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= ['$(inherited)']
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] += [
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_PHOTOS=1',
      ]
    end
  end

  # Agora ships its iOS xcframeworks with embedded bitcode. TestFlight
  # rejects the build with "Invalid Executable — AgoraRtmKit.framework
  # contains bitcode" (and the same for AgoraRtcKit, IrisRTC, …).
  # bitcode_strip removes the bitcode Mach-O section in place — the
  # executable code itself is untouched, so matching / RTC / RTM / video
  # behaviour is unchanged.
  bitcode_strip = `xcrun --find bitcode_strip`.chomp
  if bitcode_strip.empty?
    raise '[DateNow] bitcode_strip not found in the active Xcode toolchain'
  end
  pods_root = installer.sandbox.root.to_s
  stripped = 0
  Dir.glob(
    "#{pods_root}/{AgoraRtm_iOS,AgoraRtcEngine_iOS,AgoraIrisRTC_iOS}/**/*.xcframework",
  ).each do |xcf|
    Dir.glob("#{xcf}/**/*.framework").each do |fw|
      binary = File.join(fw, File.basename(fw, '.framework'))
      next unless File.file?(binary)
      if system("'#{bitcode_strip}' -r '#{binary}' -o '#{binary}' >/dev/null 2>&1")
        stripped += 1
      end
    end
  end
  puts "[DateNow] Stripped bitcode from #{stripped} Agora framework binaries"
end
